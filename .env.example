# Copy to .env — the stdio server loads it automatically at startup.
# (For the Cloudflare Worker, use `npx wrangler secret put DISQUS_API_KEY` instead.)

# Disqus public API key for get_module_reviews.
# Create an application at https://disqus.com/api/applications/ and paste its "API Key".
DISQUS_API_KEY=

# Optional: override the auto-derived academic year (format: 2025-2026).
# NUSMODS_ACAD_YEAR=

# Deployed MCP endpoint used by scripts/remote.mjs.
# NUSMODS_MCP_URL=https://your-host.example.com/mcp
