{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nusmods-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-03",
  // nodejs_compat provides node:crypto/os/path/fs shims so shared code (and
  // cheerio) bundles cleanly on Workers. The stdio DiskCache is never invoked
  // in the Worker because worker.ts swaps in KvCacheStore at init().
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Durable Object hosting the McpAgent instance.
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "NusModsMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NusModsMcp"]
    }
  ],
  // Cache namespace. Local `wrangler dev` auto-provisions this binding with a
  // local KV store, so no id is needed to test. Before `wrangler deploy`, run
  //   npx wrangler kv namespace create CACHE
  // and paste the returned id below (replace the placeholder).
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
